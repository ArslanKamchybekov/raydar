generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Locations {
  ARC                                     @map("academic and residential complex")
  AH                                      @map("addams hall")
  BSB                                     @map("behavioral sciences building")
  BH                                      @map("burnham hall")
  DH                                      @map("douglass hall")
  GH                                      @map("grant hall")
  HH                                      @map("henry hall")
  LC_A                                    @map("lecture center building a")
  LC_B                                    @map("lecture center building b")
  LC_C                                    @map("lecture center building c")
  LC_D                                    @map("lecture center building d")
  LC_E                                    @map("lecture center building e")
  LC_F                                    @map("lecture center building f")
  LH                                      @map("lincoln hall")
  SH                                      @map("stevenson hall")
  UH                                      @map("university hall")
  TH                                      @map("taft hall")
  CS                                      @map("commons south")
  SELW                                    @map("science and engineering labratory west")
  SELE                                    @map("science and engineering labratory east")
  UICE                                    @map("uic student center east")
  RJDL                                    @map("richard j daley library")
}

enum Categories {
  PERSONAL                                @map("personal")
  ELECTRONICS                             @map("electronics")
  CLOTHING                                @map("clothing")
  DOCUMENTS                               @map("documents")
  LOCKS                                   @map("locks")
  BAGS                                    @map("bags")
  JEWELRY                                 @map("jewelry")
  SPORTS                                  @map("sports")
  GAMES                                   @map("games")
  BOOKS                                   @map("books")
  HOUSEHOLD_ITEMS                         @map("household")
  TOOLS                                   @map("tools")
  VEHICLES                                @map("vehicles")
  OFFICE                                  @map("office")
  MEDICAL                                 @map("medical")
  PET                                     @map("pet")
  OUTDOOR                                 @map("outdoor")
  TRAVEL                                  @map("travel")
  COLLECTIBLES                            @map("collectibles")
  MISCELLANEOUS                           @map("miscellaneous")
}

enum Brands {
  APPLE                                   @map("apple")
  SAMSUNG                                 @map("samsung")
  DELL                                    @map("dell")
  HP                                      @map("hp")
  LENOVO                                  @map("lenovo")
  MICROSOFT                               @map("microsoft")
  NIKE                                    @map("nike")
  ADIDAS                                  @map("adidas")
  SONY                                    @map("sony")
  JBL                                     @map("jbl")
  BEATS                                   @map("beats")
  ASUS                                    @map("asus")
}

enum Colors {
  RED                                     @map("red")
  BLUE                                    @map("blue")
  GREEN                                   @map("green")
  BLACK                                   @map("black")
  WHITE                                   @map("white")
  GRAY                                    @map("gray")
  YELLOW                                  @map("yellow")
  PURPLE                                  @map("purple")
  PINK                                    @map("pink")
  ORANGE                                  @map("orange")
  BROWN                                   @map("brown")
}

enum Size {
  S                                       @map("small")
  M                                       @map("medium")
  L                                       @map("large")
}

enum Materials {
  PLASTIC                                 @map("plastic")
  METAL                                   @map("metal")
  FABRIC                                  @map("fabric")
  LEATHER                                 @map("leather")
  WOOD                                    @map("wood")
  GLASS                                   @map("glass")
  CERAMIC                                 @map("ceramic")
  RUBBER                                  @map("rubber")
  COMPOSITE                               @map("composite")
  SYNTHETIC                               @map("synthetic")
}

enum Weather {
  SUNNY                                   @map("sunny")
  PARTLY_CLOUDY                           @map("partly cloudy")
  CLOUDY                                  @map("cloudy")
  RAINY                                   @map("rainy")
  STORMY                                  @map("stormy")
  SNOWY                                   @map("snowy")
  WINDY                                   @map("windy")
  FOGGY                                   @map("foggy")
}


model found_items { // We will upload mock images here and fill ALL fields (optional or not).
  id                BigInt                @id @default(autoincrement()) // If we get to a reporting system, then user uploaded found items will get entered here as well, but in that case, the optional fields are optional.
  created_at        DateTime              @default(now())
  image_id          String                @default(uuid())
  image_name        String
  location_name     Locations?
  category          Categories?
  brand             Brands?
  colors            Colors[]
  size              Size?
  material          Materials?
  weather_found     Weather?
  description       String?
  keywords          String[]
}

model lost_items { // When user uploads a lost sketch/image, the images get entered here and entered into the "lost_images" bucket with the same name as image_name
  id              BigInt                 @id @default(autoincrement())
  created_at      DateTime               @default(now())
  image_id        String                 @default(uuid())
  image_name      String 
}



// Models below are non-Raydar
model user {
  id                Int                 @id @default(autoincrement())
  created_time      DateTime            @default(now())
  email             String              @unique
  first_name        String?
  last_name         String?
  gender            String?
  profile_image_url String?
  user_id           String              @unique
  subscription      String?
}

model payments {
  id               Int                  @id @default(autoincrement())
  created_time     DateTime             @default(now())
  stripe_id        String
  email            String
  amount           String
  payment_time     String
  payment_date     String
  currency         String
  user_id          String
  customer_details String
  payment_intent   String
}

model subscriptions {
  id                        Int        @id @default(autoincrement())
  created_time              DateTime   @default(now())
  subscription_id           String
  stripe_user_id            String
  status                    String
  start_date                String
  end_date                  String?
  plan_id                   String
  default_payment_method_id String?
  email                     String
  user_id                   String
}

model subscriptions_plans {
  id           Int                     @id @default(autoincrement())
  created_time DateTime                @default(now())
  plan_id      String
  name         String
  description  String
  amount       String
  currency     String
  interval     String
}

model invoices {
  id              Int                  @id @default(autoincrement())
  created_time    DateTime             @default(now())
  invoice_id      String
  subscription_id String
  amount_paid     String
  amount_due      String?
  currency        String
  status          String
  email           String
  user_id         String?
}
